# ==============================================================================
# Shopkeeper-Customer Voice Billing & AI Inventory System
# Environment Configuration Template
# Copy this file to .env and adjust values if needed.
# Do NOT commit sensitive keys or secrets into source control.
# ==============================================================================

# Application Configuration
APP_NAME="Shopkeeper-Customer Voice Billing & AI Inventory System"
APP_ENV="development"
DEBUG=True
HOST="127.0.0.1"
PORT=8000

# Database Configuration (SQLite local database file)
DATABASE_URL="sqlite:///./data/shopkeeper.db"

# Voice & TTS Configuration
# Options: elevenlabs | edge-tts | browser (default: edge-tts or browser fallback if no API key is provided)
VOICE_PROVIDER="edge-tts"
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID="JBFqnCBsd6RMkjVDRZzb"
ELEVENLABS_MODEL_ID="eleven_flash_v2_5"

# Kirana AI Copilot (Groq LLM)
# If left empty, a built-in deterministic offline fallback engine answers queries.
GROQ_API_KEY=""
GROQ_MODEL="qwen/qwen3.8-27b"

# Firebase Authentication Configuration (Dummy link - swap with real credentials anytime)
FIREBASE_API_KEY="DUMMY_FIREBASE_API_KEY_REPLACE_LATER"
FIREBASE_AUTH_DOMAIN="apna-kirana-pos-dummy.firebaseapp.com"
FIREBASE_DATABASE_URL="https://apna-kirana-pos-dummy-default-rtdb.firebaseio.com"
FIREBASE_PROJECT_ID="apna-kirana-pos-dummy"
FIREBASE_STORAGE_BUCKET="apna-kirana-pos-dummy.appspot.com"
FIREBASE_MESSAGING_SENDER_ID="123456789012"
FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890abcdef"
FIREBASE_MEASUREMENT_ID="G-DUMMY12345"

